		"type": "git",
		"url": "git+https://github.com/hub-env/ng-hub-ui-spreadsheet.git"
	},
	"bugs": {
		"url": "https://github.com/hub-env/hub-ui/issues"
	},
	"homepage": "https://hubui.dev/en/spreadsheet/overview/",
	"keywords": [
		"angular",
		"spreadsheet",
		"data-grid",
		"editable-table",
		"excel",
		"clipboard",
		"cell-editing",
		"range-selection",
		"accessibility",
		"ng-hub-ui",
		"standalone",
		"signals"
	],
	"peerDependencies": {
		"@angular/common": ">=22.0.0",
		"@angular/core": ">=22.0.0",
		"ng-hub-ui-ds": ">=22.0.0",
		"ng-hub-ui-utils": ">=22.19.0",
		"@angular/forms": ">=22.0.0"
	},
	"peerDependenciesMeta": {
		"ng-hub-ui-ds": {
			"optional": true
		},
		"@angular/forms": {
			"optional": true
		}
	},
	"dependencies": {
		"tslib": "^2.3.0"
	},
	"exports": {
		"./styles": "./styles/index.scss",
		"./styles/index.scss": "./styles/index.scss",
